FROM node:20-bookworm-slim AS deps

WORKDIR /app

ENV CI=true

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json* ./
COPY apps/backend/package.json apps/backend/package.json
COPY apps/storefront/package.json apps/storefront/package.json

RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

FROM deps AS builder

ARG NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api-sklep.invinciblepolska.pl
ARG NEXT_PUBLIC_DEFAULT_REGION=pl
ARG NEXT_PUBLIC_BASE_URL=https://sklep.invinciblepolska.pl
ARG NEXT_PUBLIC_STRIPE_KEY=
ARG NEXT_PUBLIC_SHOP_MODE=demo
ARG NEXT_PUBLIC_SHOP_NAME="Invincible Store"
ARG NEXT_PUBLIC_SHOP_LOCALE=pl-PL
ARG NEXT_PUBLIC_SHOP_CURRENCY=PLN
ARG NEXT_PUBLIC_SHOP_TAGLINE="Sklep dla fanów Invincible"
ARG NEXT_PUBLIC_SHOP_DESCRIPTION="Odzież, gadżety i produkty dla fanów Invincible."
ARG NEXT_PUBLIC_COMPANY_NAME="Invincible Polska"
ARG NEXT_PUBLIC_COMPANY_STREET="Adres zostanie uzupełniony"
ARG NEXT_PUBLIC_COMPANY_POSTAL_CODE="30-000"
ARG NEXT_PUBLIC_COMPANY_CITY="Kraków"
ARG NEXT_PUBLIC_COMPANY_COUNTRY="Polska"
ARG NEXT_PUBLIC_COMPANY_EMAIL="kontakt@invinciblepolska.pl"
ARG NEXT_PUBLIC_COMPANY_PHONE="+48 000 000 000"
ARG NEXT_PUBLIC_COMPANY_NIP="wkrótce"
ARG NEXT_PUBLIC_CONTACT_EMAIL="kontakt@invinciblepolska.pl"
ARG NEXT_PUBLIC_CONTACT_PHONE="+48 000 000 000"
ARG NEXT_PUBLIC_CONTACT_WORKING_HOURS="Poniedziałek–piątek, 9:00–17:00"
ARG NEXT_PUBLIC_SOCIAL_FACEBOOK=
ARG NEXT_PUBLIC_SOCIAL_INSTAGRAM=
ARG NEXT_PUBLIC_SOCIAL_TIKTOK=
ARG NEXT_PUBLIC_SOCIAL_LINKEDIN=
ARG NEXT_PUBLIC_PRIVACY_POLICY_UPDATED_AT=2026-07-01
ARG NEXT_PUBLIC_TERMS_UPDATED_AT=2026-07-01

ENV NODE_ENV=production
ENV NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=$NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY
ENV NEXT_PUBLIC_MEDUSA_BACKEND_URL=$NEXT_PUBLIC_MEDUSA_BACKEND_URL
ENV NEXT_PUBLIC_DEFAULT_REGION=$NEXT_PUBLIC_DEFAULT_REGION
ENV NEXT_PUBLIC_BASE_URL=$NEXT_PUBLIC_BASE_URL
ENV NEXT_PUBLIC_STRIPE_KEY=$NEXT_PUBLIC_STRIPE_KEY
ENV NEXT_PUBLIC_SHOP_MODE=$NEXT_PUBLIC_SHOP_MODE
ENV NEXT_PUBLIC_SHOP_NAME=$NEXT_PUBLIC_SHOP_NAME
ENV NEXT_PUBLIC_SHOP_LOCALE=$NEXT_PUBLIC_SHOP_LOCALE
ENV NEXT_PUBLIC_SHOP_CURRENCY=$NEXT_PUBLIC_SHOP_CURRENCY
ENV NEXT_PUBLIC_SHOP_TAGLINE=$NEXT_PUBLIC_SHOP_TAGLINE
ENV NEXT_PUBLIC_SHOP_DESCRIPTION=$NEXT_PUBLIC_SHOP_DESCRIPTION
ENV NEXT_PUBLIC_COMPANY_NAME=$NEXT_PUBLIC_COMPANY_NAME
ENV NEXT_PUBLIC_COMPANY_STREET=$NEXT_PUBLIC_COMPANY_STREET
ENV NEXT_PUBLIC_COMPANY_POSTAL_CODE=$NEXT_PUBLIC_COMPANY_POSTAL_CODE
ENV NEXT_PUBLIC_COMPANY_CITY=$NEXT_PUBLIC_COMPANY_CITY
ENV NEXT_PUBLIC_COMPANY_COUNTRY=$NEXT_PUBLIC_COMPANY_COUNTRY
ENV NEXT_PUBLIC_COMPANY_EMAIL=$NEXT_PUBLIC_COMPANY_EMAIL
ENV NEXT_PUBLIC_COMPANY_PHONE=$NEXT_PUBLIC_COMPANY_PHONE
ENV NEXT_PUBLIC_COMPANY_NIP=$NEXT_PUBLIC_COMPANY_NIP
ENV NEXT_PUBLIC_CONTACT_EMAIL=$NEXT_PUBLIC_CONTACT_EMAIL
ENV NEXT_PUBLIC_CONTACT_PHONE=$NEXT_PUBLIC_CONTACT_PHONE
ENV NEXT_PUBLIC_CONTACT_WORKING_HOURS=$NEXT_PUBLIC_CONTACT_WORKING_HOURS
ENV NEXT_PUBLIC_SOCIAL_FACEBOOK=$NEXT_PUBLIC_SOCIAL_FACEBOOK
ENV NEXT_PUBLIC_SOCIAL_INSTAGRAM=$NEXT_PUBLIC_SOCIAL_INSTAGRAM
ENV NEXT_PUBLIC_SOCIAL_TIKTOK=$NEXT_PUBLIC_SOCIAL_TIKTOK
ENV NEXT_PUBLIC_SOCIAL_LINKEDIN=$NEXT_PUBLIC_SOCIAL_LINKEDIN
ENV NEXT_PUBLIC_PRIVACY_POLICY_UPDATED_AT=$NEXT_PUBLIC_PRIVACY_POLICY_UPDATED_AT
ENV NEXT_PUBLIC_TERMS_UPDATED_AT=$NEXT_PUBLIC_TERMS_UPDATED_AT

COPY . .

RUN npm run build --workspace=@dtc/storefront

FROM node:20-bookworm-slim AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=8000

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app /app

EXPOSE 8000

CMD ["npm", "run", "start", "--workspace=@dtc/storefront"]
