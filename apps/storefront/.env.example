# ==================================================
# MEDUSA / STOREFRONT
# ==================================================

NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY="pk_..."
NEXT_PUBLIC_MEDUSA_BACKEND_URL="http://localhost:9000"
NEXT_PUBLIC_DEFAULT_REGION="pl"
NEXT_PUBLIC_BASE_URL="http://localhost:8000"

# Stripe public key, jeśli sklep używa Stripe.
# Jeśli nie używasz Stripe, zostaw puste.
NEXT_PUBLIC_STRIPE_KEY=""

# Opcjonalne ustawienia obrazów / S3 / Medusa Cloud.
MEDUSA_CLOUD_S3_HOSTNAME=""
MEDUSA_CLOUD_S3_PATHNAME=""

NODE_ENV="development"

# ==================================================
# SHOP TEMPLATE CONFIG
# Publiczna konfiguracja widoczna po stronie storefrontu.
# Nie wpisuj tutaj sekretów, haseł ani prywatnych tokenów.
# ==================================================

NEXT_PUBLIC_SHOP_MODE="demo"
NEXT_PUBLIC_SHOP_NAME="Invincible Shop"
NEXT_PUBLIC_SHOP_LOCALE="pl-PL"
NEXT_PUBLIC_SHOP_CURRENCY="PLN"
NEXT_PUBLIC_SHOP_TAGLINE="Sklep dla fanów Invincible"
NEXT_PUBLIC_SHOP_DESCRIPTION="Odzież, gadżety i przykładowe produkty w komercyjnym szablonie Medusa + Next.js."

# ==================================================
# DANE FIRMY / SPRZEDAWCY
# ==================================================

NEXT_PUBLIC_COMPANY_NAME="Invincible Polska"
NEXT_PUBLIC_COMPANY_STREET="ul. Przykładowa 12/4"
NEXT_PUBLIC_COMPANY_POSTAL_CODE="30-001"
NEXT_PUBLIC_COMPANY_CITY="Kraków"
NEXT_PUBLIC_COMPANY_COUNTRY="Polska"
NEXT_PUBLIC_COMPANY_EMAIL="kontakt@example.com"
NEXT_PUBLIC_COMPANY_PHONE="+48 000 000 000"
NEXT_PUBLIC_COMPANY_NIP="0000000000"

# ==================================================
# KONTAKT DLA KLIENTÓW
# ==================================================

NEXT_PUBLIC_CONTACT_EMAIL="kontakt@example.com"
NEXT_PUBLIC_CONTACT_PHONE="+48 000 000 000"
NEXT_PUBLIC_CONTACT_WORKING_HOURS="Poniedziałek–piątek, 9:00–17:00"

# ==================================================
# SOCIAL MEDIA
# Zostaw puste, jeśli sklep nie używa danego kanału.
# ==================================================

NEXT_PUBLIC_SOCIAL_FACEBOOK=""
NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
NEXT_PUBLIC_SOCIAL_TIKTOK=""
NEXT_PUBLIC_SOCIAL_LINKEDIN=""

# ==================================================
# DATY AKTUALIZACJI DOKUMENTÓW
# ==================================================

NEXT_PUBLIC_PRIVACY_POLICY_UPDATED_AT="2026-07-01"
NEXT_PUBLIC_TERMS_UPDATED_AT="2026-07-01"
